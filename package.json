{
  "name": "thewall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/lib src/components --exclude src/lib/testing/**",
    "test:component": "vitest run src/components",
    "test:invariants": "vitest run src/lib/testing",
    "test:db": "node scripts/verify-migrations.mjs",
    "test:integration": "vitest run src/lib/testing/suites src/lib/payment src/lib/data",
    "test:security": "vitest run src/lib/testing/suites/10-privacy.test.ts src/lib/testing/suites/11-xss-content.test.tsx src/lib/testing/suites/22-payment-impersonation.test.ts src/lib/admin/security.test.ts src/lib/security src/lib/env/production.test.ts",
    "test:accessibility": "vitest run src/components/a11y.test.tsx",
    "test:lifecycle": "vitest run src/lib/testing/suites/01-lifecycle.test.tsx src/lib/testing/suites/23-complete-wall.test.ts",
    "test:critical": "vitest run src/lib/testing && node scripts/verify-migrations.mjs",
    "test:qa": "node scripts/qa.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:load": "node scripts/load-report.mjs",
    "test:all": "node scripts/qa.mjs && vitest run && node scripts/verify-migrations.mjs",
    "db:verify": "node scripts/verify-migrations.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.10",
    "@marsidev/react-turnstile": "^1.6.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3",
    "viem": "^2.55.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}

# Browser-safe (exposed to the client). NEVER put secrets here.
# Production: set this to the live origin, e.g. https://thewall.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave blank to use the built-in local Wall. Fill both for a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dummy always-pass Turnstile keys for local development. Reading works without them.
# Production needs a real Cloudflare pair. Never put TURNSTILE_SECRET_KEY in NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_EVENT_SLUG=the-wall
NEXT_PUBLIC_BASE_NETWORK=base-sepolia
# Public treasury address users pay to. Not a secret.
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Local mock of this Wall (sentences + countdown). Pay, publish, and certificates are local — no chain.
# Leave this as live unless you need a sealed edition in /archive. Do not invent past Walls.
# Production must leave this unset or false.
NEXT_PUBLIC_SIMULATE_LIVE=true
# Optional: start THIS same Wall already frozen. Prefer Finish this Wall on /admin.
# NEXT_PUBLIC_SIMULATE_ARCHIVE=true

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BASE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Must match NEXT_PUBLIC_BASE_NETWORK. Production live money uses `base`.
BASE_NETWORK=base-sepolia
# Optional dedicated RPC / bundler to avoid public rate limits
BASE_RPC_URL=
BASE_BUNDLER_URL=
# Local simulation admin (used only when Supabase is unset). Production uses a real Auth user.
ADMIN_LOCAL_EMAIL=admin@thewall.local
ADMIN_LOCAL_PASSWORD=thewall-local-admin
# Comma-separated administrator emails that may access /admin when Supabase Auth is configured.
# Optional HTTPS webhook for server error reports (Sentry-compatible JSON is not required).
# ERROR_WEBHOOK_URL=https://example.com/errors
ADMIN_EMAILS=you@example.com
PAYMENT_INTENT_TTL_SECONDS=900
# Optional: POST the sealed public archive (no wallets or keys) to a replica.
# ARCHIVE_REPLICA_WEBHOOK_URL=
# Optional: POST only the fingerprint for an independent notice.
# ARCHIVE_PROOF_WEBHOOK_URL=
# Optional Monument canvas. One screen. Unset uses the default surface.
# MONUMENT_CANVAS_WIDTH=1440
# MONUMENT_CANVAS_HEIGHT=900
# MONUMENT_CELL_WIDTH=280
# MONUMENT_CELL_HEIGHT=160
# Optional cap of plots. Unset = the canvas grid is the limit. Do not announce it.
# MONUMENT_CAPACITY=

# Crypto payment (The Wall)
# Copy to .env.local and fill in your treasury.

# 84532 = Base Sepolia (testnet) | 8453 = Base | 11155111 = Ethereum Sepolia | 1 = Ethereum
VITE_CHAIN_ID=84532

# Wallet that receives the $1-equivalent native token payment
VITE_TREASURY_ADDRESS=0x000000000000000000000000000000000000dEaD

# Native token amount (ETH/ETH-equivalent). Adjust toward ~$1 on your target chain.
VITE_PAYMENT_ETH=0.0001

# How many block confirmations before a message may publish
VITE_TX_CONFIRMATIONS=1

# Set true only for local demo without a wallet (simulates a confirmed tx)
VITE_ALLOW_DEMO_CRYPTO=true

# Emergency admin removal key (client prototype only — use a real auth gate in production)
# If unset, the demo fallback is: wall-emergency
VITE_ADMIN_KEY=wall-emergency

# Cloudflare Turnstile site key (leave empty to use the local demo checkbox)
# Test always-pass key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Secret for reaction-receipt signatures (move to server in production)
VITE_RANKING_SECRET=wall-ranking-prototype-secret
